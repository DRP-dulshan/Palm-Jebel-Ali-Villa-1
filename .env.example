# Where enquiry form submissions are emailed.
# Defaults to office@dubairapidproperties.com if unset.
LEAD_EMAIL=office@dubairapidproperties.com

# Resend API key — https://resend.com/api-keys
# REQUIRED in production: without it the form returns an error rather than
# pretending a lead was sent.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender address. The domain must be verified in Resend, otherwise delivery
# will fail. onboarding@resend.dev works for testing but ONLY delivers to the
# email address that owns the Resend account.
LEAD_FROM="Wave Crest <leads@dubairapidproperties.com>"

# Bitrix24 inbound webhook BASE url, WITH a trailing slash — the method name
# is appended to it, giving .../crm.lead.add.json
# This URL carries its own auth token, so treat it as a secret. Server only.
# If unset, leads are still emailed; only the CRM copy is skipped.
BITRIX_WEBHOOK_URL=https://yourcompany.bitrix24.com/rest/1/xxxxxxxxxxxx/
